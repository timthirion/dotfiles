# Shrink line height by 20%
adjust-cell-height = -20%

# Colors
background = #1e1e2e

# Font
font-family = "SpaceMono Nerd Font"
font-feature = -calt
font-thicken = true

# Window maximization is set per-platform in config.local

# Theme
theme = catppuccin-mocha.conf

# Disable bold and italic formatting
bold-is-bright = false

# Internal padding
window-padding-x = 12
window-padding-y = 12

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Mouse
focus-follows-mouse = true

# Platform-specific overrides (symlinked by fish config based on OS)
config-file = config.local
