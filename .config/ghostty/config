# Shrink line height by 20%
adjust-cell-height = -20%

# Colors
background = #1e1e2e

# Font
# Use the "Mono" variant: it's the only SpaceMono Nerd Font family with all
# four styles installed (the plain family ships Regular alone, so bold and
# italic were being synthesized), and its icon glyphs are forced to a fixed
# advance width so Nerd Font symbols can't shift column alignment.
font-family = "SpaceMono Nerd Font Mono"
font-feature = -calt
font-thicken = true

# Window maximization is set per-platform in config.local

# Theme
theme = catppuccin-mocha.conf

# Disable bold and italic formatting
bold-is-bright = false

# Internal padding
window-padding-x = 12
window-padding-y = 12

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Mouse
focus-follows-mouse = true

# Platform-specific overrides (symlinked by fish config based on OS)
config-file = config.local
